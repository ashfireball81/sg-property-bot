# SG Property Bot - Environment Configuration
# Copy this to .env and fill in the values
# ============================================================

# ============================================================
# DATABASE & CACHE (Production - Fly.io)
# ============================================================
# Get these values after running: flyctl postgres connect-string sg-property-db
# And: flyctl redis connect-string sg-property-cache
DATABASE_URL=postgresql://username:password@sg-property-db.internal:5432/sg_property_bot
REDIS_URL=redis://sg-property-cache.internal:6379

# ============================================================
# API CONFIGURATION
# ============================================================
API_PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# ============================================================
# EXTERNAL APIs (To be provided)
# ============================================================

# RapidAPI for 99.co Property Data
# Get from: https://rapidapi.com/99co-official/api/99-co-sg
RAPIDAPI_KEY=YOUR_RAPIDAPI_KEY_HERE

# NewsAPI for Building Intelligence
# Get from: https://newsapi.org
NEWSAPI_KEY=YOUR_NEWSAPI_KEY_HERE

# URA Data Service (Singapore Government)
# Register at: https://www.ura.gov.sg/maps/?service=dataservice
URA_ACCESS_KEY=YOUR_URA_ACCESS_KEY_HERE

# ============================================================
# TELEGRAM BOT (For Alerts & Notifications)
# To be provided by user
# ============================================================

# Telegram Bot Token
# Get from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Default chat ID for alerts (or specific user/group ID)
# Format: 123456789 (get using @userinfobot)
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# ============================================================
# SCRAPER CONFIGURATION
# ============================================================
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT=30000
SCRAPER_CONCURRENT_JOBS=3
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Optional: Proxy list (comma-separated) for IP rotation
# SCRAPER_PROXY_LIST=http://proxy1:port,http://proxy2:port

# ============================================================
# LOGGING CONFIGURATION
# ============================================================
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=7

# ============================================================
# ALERT SYSTEM (Phase 2+)
# ============================================================

# Email alerts (optional)
# ALERT_EMAIL_ENABLED=false
# ALERT_EMAIL_FROM=bot@propertybot.sg
# ALERT_SMTP_SERVER=smtp.gmail.com
# ALERT_SMTP_PORT=587
# ALERT_SMTP_USER=YOUR_EMAIL@gmail.com
# ALERT_SMTP_PASS=YOUR_APP_PASSWORD

# SMS alerts (optional)
# ALERT_SMS_ENABLED=false
# ALERT_SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=YOUR_ACCOUNT_SID
# TWILIO_AUTH_TOKEN=YOUR_AUTH_TOKEN
# TWILIO_PHONE_FROM=+65XXXXXXXXX

# ============================================================
# MONITORING & OBSERVABILITY (Phase 2+)
# ============================================================

# Sentry for error tracking (optional)
# SENTRY_DSN=https://YOUR_KEY@sentry.io/PROJECT_ID

# Performance monitoring (optional)
# METRICS_ENABLED=false
# METRICS_INTERVAL=60000

# ============================================================
# FEATURE FLAGS (Phase 2+)
# ============================================================

# Enable specific data sources (for gradual rollout)
ENABLE_PROPERTYGURU_SCRAPER=true
ENABLE_URA_API=true
ENABLE_99CO_API=true
ENABLE_DATA_GOV_SG=true
ENABLE_EDGEPROP_SCRAPER=false
ENABLE_CBRE_SCRAPER=false
ENABLE_JLL_SCRAPER=false
ENABLE_CW_SCRAPER=false
ENABLE_NEWS_API=false

# ============================================================
# BACKUP & RECOVERY (Phase 2+)
# ============================================================

# Backup configuration
# BACKUP_ENABLED=true
# BACKUP_FREQUENCY=daily  # daily, weekly, monthly
# BACKUP_RETENTION_DAYS=90

# ============================================================
# DEVELOPMENT / DEBUG (Local development only)
# ============================================================

# Only set these for local development
# DEBUG=true
# DATABASE_URL=postgresql://propertybot:propertybot123@localhost:5432/sg_property_bot
# REDIS_URL=redis://localhost:6379
# NODE_ENV=development
# API_PORT=3000

# ============================================================
# Fly.io Specific (Auto-set on deployment)
# ============================================================

# FLY_APP_NAME will be set automatically
# FLY_REGION=sin (Singapore)
# FLY_API_TOKEN=YOUR_FLY_API_TOKEN (optional, for API access)

# ============================================================
# SECTION: CREDENTIAL INJECTION CHECKLIST
# ============================================================
# Copy this section and provide filled values when ready:
#
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# RAPIDAPI_KEY=
# NEWSAPI_KEY=
# URA_ACCESS_KEY=
# DATABASE_URL=
# REDIS_URL=
#
# ============================================================
