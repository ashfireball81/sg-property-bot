# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sg_property_bot
REDIS_URL=redis://localhost:6379

# API Configuration
API_PORT=3000
NODE_ENV=development

# External APIs
RAPIDAPI_KEY=your_rapidapi_key_here
NEWSAPI_KEY=your_newsapi_key_here
URA_ACCESS_KEY=your_ura_access_key_here

# Scraper Configuration
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT=30000
SCRAPER_CONCURRENT_JOBS=3
SCRAPER_PROXY_LIST=

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Alerts
ALERT_EMAIL_FROM=bot@propertybot.sg
ALERT_SMTP_SERVER=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASS=

# Fly.io (if deployed)
FLY_APP_NAME=sg-property-bot
FLY_API_TOKEN=
